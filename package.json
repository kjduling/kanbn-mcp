{
  "name": "@kduling/kanbn-mcp",
  "version": "1.3.5",
  "description": "A Model Context Protocol (MCP) server for Kanbn board management",
  "main": "dist/server.js",
  "bin": {
    "kanbn-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "test:coverage": "c8 --reporter=lcov --reporter=text --reporter=html tsx --test tests/**/*.test.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist docs coverage",
    "nuke": "rm -rf dist docs coverage node_modules package-lock.json && npm cache clean --force",
    "docs": "echo '(typedoc --entryPointStrategy expand src) not yet supported in TypeScript7'",
    "docs:serve": "echo '(typedoc --entryPointStrategy expand src && python -m http.server 8080 --directory docs) not yet supported in TypeScript7'",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kanbn",
    "kanban",
    "board"
  ],
  "author": "Kevin J. Duling",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjduling/kanbn-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kjduling/kanbn-mcp/issues"
  },
  "homepage": "https://github.com/kjduling/kanbn-mcp",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.5.0",
    "c8": "^10.1.3",
    "eslint": "^9.20.0",
    "eslint-plugin-sonarjs": "^3.0.1",
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "@basementuniverse/kanbn": "^2.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
